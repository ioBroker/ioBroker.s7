{
  "name": "iobroker.s7",
  "version": "3.0.0",
  "description": "Siemens S7 over Snap7",
  "author": {
    "name": "smiling_Jack",
    "email": "smiling_Jack@ioBroker.net"
  },
  "contributors": [
    {
      "name": "bluefox",
      "email": "dogafox@gmail.com"
    },
    {
      "name": "smiling_Jack",
      "email": "smiling_Jack@ioBroker.net"
    },
    {
      "name": "Apollon77",
      "email": "ingo@fischer-ka.de"
    }
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.s7",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "PLC",
    "SPS",
    "Siemens",
    "Smart Home",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.s7"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "node-snap7": "^1.0.9",
    "iconv-lite": "^0.7.3",
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/build-tools": "^3.0.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/legacy-testing": "^3.0.0",
    "@types/node": "^25.2.0",
    "axios": "^1.19.0",
    "nan": "2.28.0",
    "typescript": "^6.0.3"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.s7/issues"
  },
  "readmeFilename": "README.md",
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "docs/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "mocha --exit",
    "test:package": "mocha test/testPackageFiles.js --exit",
    "test:integration": "mocha --exit",
    "build": "npm run build:backend && node tasks",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:gui": "node tasks --1-npm && node tasks --2-build && node tasks --3-copy && node tasks --4-patch",
    "check:ts": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "prepublishOnly": "npm run build",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx npm-check-updates --upgrade && cd src-admin && npx npm-check-updates --upgrade",
    "npm": "npm i && cd src-admin && npm i -f"
  }
}
