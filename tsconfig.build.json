// Specialized tsconfig, which compiles the backend from `src` into `build`
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": false,
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts"],
    "exclude": ["build/**", "node_modules/**", "src-admin/**", "admin/**", "test/**"]
}
